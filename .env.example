DATABASE_URL=
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel Blob (required on Vercel for media uploads)
BLOB_READ_WRITE_TOKEN=

# Email (pick ONE provider; with neither, emails are only logged to the console)
EMAIL_FROM_ADDRESS=hello@yourdomain.com
EMAIL_FROM_NAME=D3TY
# Option A — Resend (https://resend.com), recommended on Vercel
RESEND_API_KEY=
# Option B — any SMTP server (Gmail app password, Brevo, Mailgun…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: send ALL emails to this address instead (for testing)
EMAIL_OVERRIDE_TO=
